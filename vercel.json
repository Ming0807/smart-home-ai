{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/webui/index"
    },
    {
      "source": "/app",
      "destination": "/webui/mobile"
    },
    {
      "source": "/app/:path*",
      "destination": "/webui/mobile"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/webui/manifest.webmanifest"
    },
    {
      "source": "/mobile-service-worker.js",
      "destination": "/webui/mobile-service-worker.js"
    }
  ],
  "headers": [
    {
      "source": "/mobile-service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/webui/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

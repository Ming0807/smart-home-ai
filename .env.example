# Copy this file to `.env` on each machine.
# Do not commit real `.env` files because they may contain API keys.

# App
APP_ENV=development
APP_DEBUG=false
DEBUG_LOGS=false
DEMO_MODE=true
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://smart-home-ai-lyart.vercel.app

# Ollama / LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=30m
OLLAMA_WARMUP_TIMEOUT_SECONDS=75
CHAT_TIMEOUT_SECONDS=30
LLM_WARMUP_ON_START=true
LLM_KEEP_AWAKE_IN_DEMO=true
LLM_KEEP_AWAKE_INTERVAL_SECONDS=240
LLM_MAX_TOKENS=120
LLM_GENERAL_MAX_TOKENS=32
LLM_REASONING_MAX_TOKENS=48
LLM_THINKING_MAX_TOKENS=384
LLM_NUM_CTX=1024
LLM_TEMPERATURE=0.2

# Optional: set only if you keep Ollama models in a custom folder.
OLLAMA_MODELS=
OLLAMA_EXE=

# ESP32 / device registry
DEFAULT_ESP32_DEVICE_ID=esp32-01
ESP32_OFFLINE_TIMEOUT_SECONDS=60
DEFAULT_RELAY_GPIO_PIN=5
DEFAULT_RELAY_ACTIVE_HIGH=true
DEFAULT_DHT22_GPIO_PIN=4
DEFAULT_PIR_GPIO_PIN=6
DEVICE_REGISTRY_PATH=data/device_registry.json
DEVICE_COMMAND_TIMEOUT_SECONDS=15
SENSOR_FRESHNESS_SECONDS=300

# Database / Supabase, optional for current demo
DATABASE_ENABLED=false
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Weather
OPENWEATHER_API_KEY=
DEFAULT_WEATHER_LOCATION=Yala,TH
WEATHER_TIMEOUT_SECONDS=5
WEATHER_CACHE_TTL_SECONDS=600

# News
CURRENTS_API_KEY=
NEWS_PROVIDER=currents
NEWS_DEFAULT_LANGUAGE=th
NEWS_DEFAULT_COUNTRY=TH
NEWS_CACHE_TTL_SECONDS=600
NEWS_TIMEOUT_SECONDS=5
NEWS_MAX_ITEMS=5

# Navigation / Traffic
NAV_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=
NAV_DEFAULT_ORIGIN=Yala
NAV_TIMEOUT_SECONDS=5
NAV_CACHE_TTL_SECONDS=600
NAV_DEFAULT_LANGUAGE=th

TRAFFIC_PROVIDER=tomtom
TOMTOM_API_KEY=
TRAFFIC_TIMEOUT_SECONDS=5
TRAFFIC_CACHE_TTL_SECONDS=300
TRAFFIC_DEFAULT_LOCATION=Yala
TRAFFIC_FLOW_ZOOM=10

# LINE Messaging, optional
LINE_ENABLED=false
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=
LINE_TIMEOUT_SECONDS=5

# Voice / TTS
TTS_ENABLED=true
DEMO_VOICE_MODE=true
TTS_PROVIDER=edge_tts
TTS_OVERWRITE_OUTPUT=true
TTS_OUTPUT_FILE=current_reply.mp3
TTS_DEFAULT_VOICE=th-TH-PremwadeeNeural
TTS_OUTPUT_DIR=static

# Browser/Voice Node STT
STT_PROVIDER=faster_whisper
STT_MODEL=base
STT_LANGUAGE=th
STT_TIMEOUT_SECONDS=30
STT_WARMUP_ON_START=true
STT_BEAM_SIZE=1
STT_VAD_FILTER=true
STT_AUDIO_NORMALIZE=true
STT_NORMALIZE_TARGET_PEAK=0.82
STT_NORMALIZE_MAX_GAIN=3.0
STT_DOMAIN_CORRECTIONS=true

# Voice Node hardware
VOICE_NODE_ENABLED=true
VOICE_NODE_AUTO_WAKE_ENABLED=true
VOICE_NODE_AUTO_WAKE_REFRESH_SECONDS=10
VOICE_NODE_DEFAULT_ID=voice-node-01
VOICE_NODE_WAKE_WORD=สวัสดีน้องฟ้า
VOICE_NODE_AUDIO_FORMAT=wav
VOICE_NODE_REPLY_AUDIO_FORMAT=wav
VOICE_NODE_SAMPLE_RATE=16000
VOICE_NODE_REPLY_SAMPLE_RATE=24000
VOICE_NODE_SPOKEN_REPLY_MAX_CHARS=360
VOICE_NODE_WAV_TARGET_PEAK=0.88
VOICE_NODE_WAV_MAX_GAIN=2.2
VOICE_NODE_RECORD_SECONDS=4
VOICE_NODE_MIC_RECORD_GAIN=16
VOICE_NODE_VAD_ENABLED=true
VOICE_NODE_VAD_THRESHOLD=35
VOICE_NODE_VAD_MIN_RECORD_MS=1200
VOICE_NODE_VAD_SILENCE_STOP_MS=1000
VOICE_NODE_TIMEOUT_SECONDS=30
VOICE_NODE_HEARTBEAT_TIMEOUT_SECONDS=60
VOICE_NODE_COMMAND_TTL_SECONDS=30
VOICE_NODE_STREAM_VAD_RMS_THRESHOLD=0.025
VOICE_NODE_STREAM_VAD_START_FRAMES=3
VOICE_NODE_STREAM_VAD_END_FRAMES=10
VOICE_NODE_STREAM_PREPROCESS=true
VOICE_NODE_STREAM_TRIM_PADDING_MS=250

# UI
MAX_CHAT_HISTORY_ITEMS=50
